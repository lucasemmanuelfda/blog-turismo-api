# ===== App =====
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Origins autorizadas no CORS (separadas por virgula). So o frontend acessa a API.
CORS_ORIGINS=

# ===== Credenciais do admin =====
#
# ADMIN_KEY — credencial de MÁQUINA para a API/CI (header Authorization: Bearer).
# Também assina os tokens de sessão. Formato livre, valor secreto. Se vazio,
# as rotas de escrita ficam abertas (fora de produção) ou fechadas (produção).
ADMIN_KEY=troque-por-uma-chave-secreta

# ADMIN_PASSWORD_HASH — hash bcrypt da SENHA do painel /admin. A senha em si
# NUNCA é armazenada (só este hash aparece no ambiente). Gere com:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'sua-senha', bcrypt.gensalt()).decode())"
# Se vazio, o painel aceita a própria ADMIN_KEY como senha (modo legado).
ADMIN_PASSWORD_HASH=

# Duração da sessão do painel admin em horas (token expira e pede novo login)
ADMIN_SESSION_HOURS=24

# ===== Banco de dados (PostgreSQL via Supabase) =====
# Local (sem configurar): usa SQLite automaticamente (arquivo ./blog.db)
# Em produção (Render + Supabase), copie a connection string de:
# Supabase > Project Settings > Database > Connection string (URI) > Pooler (Transaction)
DATABASE_URL=

# ===== Geração de conteúdo com IA (todas gratuitas) =====
# Usa API compatível com OpenAI. Escolha UM provedor grátis:
#
#   Google Gemini (grátis, chave no https://aistudio.google.com):
#     AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     AI_MODEL=gemini-3.6-flash
#
#   Groq (grátis, chave no https://console.groq.com):
#     AI_BASE_URL=https://api.groq.com/openai/v1
#     AI_MODEL=openai/gpt-oss-120b
#
#   OpenRouter (modelos :free, chave no https://openrouter.ai):
#     AI_BASE_URL=https://openrouter.ai/api/v1
#     AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Idioma dos artigos gerados (ex.: pt-BR, pt, en-US, es)
AI_LANGUAGE=pt-BR

# Provedor reserva (opcional): usado automaticamente se o principal falhar.
# Ex.: Groq grátis (chave em https://console.groq.com):
AI_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=openai/gpt-oss-120b

# ===== Segundo cérebro (memória em arquivo) =====
# Arquivo que acumula fatos e títulos já publicados; reutilizados nos próximos
# prompts para evitar repetição e reduzir tokens. Não precisa mudar.
MEMORY_FILE=blog-memory.json

# Temas da geração diária automática (separados por vírgula). Endpoint /generate/daily.
# Deixe VAZIO para usar temas dinâmicos via Google Trends (transformados pela IA).
DAILY_TOPICS=

# ===== Temas dinâmicos (tendências do dia) =====
# Quando DAILY_TOPICS estiver vazio, os temas do dia vêm do Google Trends
# (pytrends) e viram tópicos "evergreen" pela IA. Configuração:
# - TRENDS_COUNTRY: sigla do país usado no Google Trends (BR, US, PT, AR...)
# - NEWS_API_KEY: chave grátis do NewsAPI.org (pesquisa leve antes da geração; também usada como reserva no Trends)
# - TOPICS_CACHE_FILE: arquivo de cache dos temas do dia (um por dia)
TRENDS_COUNTRY=BR
NEWS_API_KEY=
TOPICS_CACHE_FILE=trends-cache.json

# ===== Agendador =====
# Intervalo (em minutos) entre verificações de posts a publicar
PUBLISH_INTERVAL_MINUTES=10

# Quantidade máxima de posts por dia gerados automaticamente
MAX_POSTS_PER_DAY=5